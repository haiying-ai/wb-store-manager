# Copy only the variable names you need to the ignored local token file named in
# config/finance/stores.json, or set them as Windows user environment variables.
# Never put a real token in this example, the store registry, reports, or Git.

# owner-store: Seller API and Promotion API credential variable name.
WB_API_TOKEN=

# new-store: Seller API and Promotion API credential variable name.
WB_NEW_STORE_API_TOKEN=

# Future stores: add a unique tokenEnv/promotionTokenEnv name to the credential-
# free registry, then define that variable only in a local ignored file or user env.
# WB_<STORE_ALIAS>_API_TOKEN=

# Optional. Used by the Python client on Windows if WB TLS revocation checks are unstable.
WB_VERIFY_TLS=true
